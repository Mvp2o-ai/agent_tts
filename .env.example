# Gateway auth for hosts YOU start (Compose, VPS, manual Railway CLI, etc.).
# Required for this .env path. Generate one with `openssl rand -hex 32`, paste
# it below, and pair the phone with that same value (manual entry or QR).
# In-app provider launch does NOT read this file — the app generates its own
# token and injects it into the new container. The gateway rejects common
# placeholder values.
GATEWAY_TOKEN=

# Voice vendors (required for the mobile voice loop). BYO keys.
# Optional provider selection; defaults to the built-in adapters.
STT_PROVIDER=deepgram
TTS_PROVIDER=elevenlabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# SQLite file (bring your own volume). Compose sets this to /data/agent_tts.db.
# CONFIG_DB=./data/agent_tts.db

# Adapter argv (defaults to the in-image adapter). Override for local dev:
# AGENTBOX_COMMAND=node --import tsx ./agentbox/adapter/src/index.ts

# Harness working directory (defaults to /workspace in the image).
# WORKSPACE_DIR=/tmp/agent-tts-workspace
