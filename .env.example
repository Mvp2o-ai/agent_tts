# Shared gateway auth. Required. Use a long random string.
GATEWAY_TOKEN=change-me

# Voice vendors (required for the mobile voice loop). BYO keys.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# SQLite file (bring your own volume). Compose sets this to /data/agent_tts.db.
# CONFIG_DB=./data/agent_tts.db

# Adapter argv (defaults to the in-image adapter). Override for local dev:
# AGENTBOX_COMMAND=node --import tsx ./agentbox/adapter/src/index.ts

# Harness working directory (defaults to /workspace in the image).
# WORKSPACE_DIR=/tmp/agent-tts-workspace
