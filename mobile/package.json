{
  "name": "@agent_tts/mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint App.tsx src packages/voice-audio/src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "config:check": "expo config --type public",
    "eas-build-pre-install": "node scripts/assert-runtime-image-ready.mjs",
    "install:device": "bash scripts/eas-device-install.sh",
    "eas:device:ios": "bash scripts/eas-build-guarded.sh development ios",
    "eas:device:android": "bash scripts/eas-build-guarded.sh development android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.17",
    "expo-asset": "~57.0.15",
    "expo-auth-session": "~57.0.10",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "voice-audio": "file:./packages/voice-audio"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "14.0.1"
    }
  }
}
