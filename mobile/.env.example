# Optional fork override for the public GitHub OAuth App identity. The upstream
# Agent TTS client ID is committed in src/product-config.ts. Never put secrets
# in an EXPO_PUBLIC_ variable because Expo compiles these values into the app.
EXPO_PUBLIC_GITHUB_CLIENT_ID=

# The official Railway OAuth client ID is the default. Set this only for a
# rebranded fork with its own Railway OAuth application and callback scheme.
# EXPO_PUBLIC_RAILWAY_CLIENT_ID=

# Optional provider-neutral runtime artifact override for a fork. Use an image
# that a new provider account can pull, preferably pinned by digest.
# EXPO_PUBLIC_AGENT_RUNTIME_IMAGE=ghcr.io/your-org/agent_tts@sha256:...
